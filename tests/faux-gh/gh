#!/bin/bash
# Faux gh des tests de l'amorce : un piège. L'amorce ne lance jamais gh, même installé et connecté : tout appel est noté
# « INTERDIT » dans $FAUX_GH_JOURNAL (ses arguments seulement, jamais de jeton) et échoue.
set -u
: "${FAUX_GH_JOURNAL:?}"
printf 'INTERDIT %s\n' "$*" >> "$FAUX_GH_JOURNAL"
echo "faux gh : appel interdit" >&2
exit 2
